{
  "name": "AI Zen Workspace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "google.geminicodeassist",
        "openai.chatgpt",
        "github.copilot",
        "github.copilot-chat",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid",
        "cweijan.vscode-office",
        "pkief.material-icon-theme"
      ],
      "settings": {
        "github.copilot.enable": {
          "*": true
        },
        "github.copilot.editor.enableAutoCompletions": true,

        "workbench.activityBar.location": "default",
        "workbench.auxiliaryBar.visible": true,
        "workbench.sideBar.location": "left",
        "claude-vscode.sidebar.open": true,
        "workbench.panel.defaultLocation": "bottom",
        "workbench.colorTheme": "Default Light Modern",
        "workbench.iconTheme": "material-icon-theme",
        "workbench.startupEditor": "readme",
        "workbench.statusBar.visible": false,
        "workbench.layoutControl.enabled": false,
        "workbench.editor.showTabs": "single",
        "workbench.editor.editorActionsLocation": "hidden",

        "window.menuBarVisibility": "hidden",
        "window.commandCenter": false,

        "workbench.editorAssociations": {
          "*.xlsx": "cweijan.officeViewer",
          "*.docx": "cweijan.officeViewer",
          "*.pptx": "cweijan.officeViewer",
          "*.pdf": "cweijan.officeViewer",
          "*.csv": "cweijan.officeViewer",
          "*.md": "cweijan.markdownViewer"
        },

        "editor.minimap.enabled": false,
        "editor.breadcrumbs.enabled": false,
        "editor.lineNumbers": "off",
        "editor.folding": false,
        "editor.renderWhitespace": "none",
        "editor.guides.indentation": false,
        "editor.glyphMargin": false,
        "editor.scrollbar.horizontal": "hidden",
        "editor.scrollbar.vertical": "hidden",
        "editor.wordWrap": "on",
        "editor.fontSize": 16,
        "editor.lineHeight": 1.8,
        "editor.fontFamily": "system-ui, -apple-system, sans-serif",
        "editor.quickSuggestions": {
          "comments": "off",
          "strings": "off",
          "other": "off"
        },
        "editor.hover.enabled": false,

        "explorer.openEditors.visible": 1,
        "explorer.compactFolders": false,
        "explorer.confirmDragAndDrop": false,
        "explorer.enableDragAndDrop": false,

        "files.autoSave": "afterDelay",
        "files.exclude": {
          "**/.git": true,
          "**/.devcontainer": true,
          "**/.vscode": true,
          "**/node_modules": true,
          "**/.gitignore": true,
          "**/.env*": true
        },

        "markdown.preview.fontSize": 16,
        "markdown.preview.lineHeight": 1.6,
        "terminal.integrated.fontSize": 14,
        "telemetry.telemetryLevel": "off"
      }
    }
  },

  "postCreateCommand": "npm install -g @anthropic-ai/claude-code @google/gemini-cli && mkdir -p ~/.vscode-server/extensions/composio.composio-skills-0.1.0 && unzip -o /workspaces/${localWorkspaceFolderBasename}/.extensions/composio-skills-0.1.0.vsix -d ~/.vscode-server/extensions/composio.composio-skills-0.1.0 && mv ~/.vscode-server/extensions/composio.composio-skills-0.1.0/extension/* ~/.vscode-server/extensions/composio.composio-skills-0.1.0/ 2>/dev/null || true",

  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "GOOGLE_API_KEY": "${localEnv:GOOGLE_API_KEY}",
    "COMPOSIO_API_KEY": "${localEnv:COMPOSIO_API_KEY}"
  }
}
